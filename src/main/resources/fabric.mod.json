{
  "schemaVersion": 1,
  "id": "loadouttc",
  "version": "${version}",
  "name": "Loadout TC",
  "description": "A compact, styleable client-side HUD for equipment and status. Ships with Vanilla, Accessories, Trinkets and Curios providers, plus a slot menu, sorting and an API.",
  "authors": [
    "ToanCao"
  ],
  "license": "MIT",
  "icon": "assets/loadouttc/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.toancao.loadouttc.LoadoutTcClient"
    ],
    "modmenu": [
      "com.toancao.loadouttc.integration.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*",
    "accessories": "*",
    "trinkets": "*",
    "curios": "*"
  }
}
